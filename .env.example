# ==============================================================================
# SMARAN — Environment Configuration for Local & Vercel Production
# ==============================================================================

# 1. Public Browser-Safe Supabase Configuration (Required)
# Available in your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# 2. Canonical Site URL (Optional for Vercel)
# Used for auth redirect links, password resets, and email verification.
# On Vercel, this is automatically inferred from VERCEL_PROJECT_PRODUCTION_URL or request headers if omitted.
# Set this if using a custom domain (e.g. https://smaran.app).
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# 3. Server-Only Secrets (Required for Server Operations / Admin Cleanup)
# Never expose these in client-side bundles (do NOT prefix with NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=sb_secret_your_key_here
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
